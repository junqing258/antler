generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RunStatus {
  queued
  running
  awaiting_approval
  succeeded
  failed
  cancelled
}

model Run {
  id             String     @id
  userId         String     @default("")
  projectId      String
  conversationId String
  input          String
  status         RunStatus  @default(queued)
  errorCode      String?
  createdAt      DateTime   @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  events         RunEvent[]

  @@index([projectId, createdAt])
  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
  @@map("runs")
}

model RunEvent {
  id        Int      @id @default(autoincrement())
  runId     String
  seq       Int
  type      String
  payload   Json
  createdAt DateTime @default(now())
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, seq])
  @@index([runId, seq])
  @@map("run_events")
}

enum ScheduledTaskType {
  http
  service
  script
}

enum TaskExecutionStatus {
  running
  succeeded
  failed
  timeout
}

model ScheduledTask {
  id              String            @id @default(uuid())
  userId          String            @default("")
  name            String
  description     String?
  type            ScheduledTaskType
  schedule        String            // cron 表达式或 "delay:毫秒"
  enabled         Boolean           @default(true)
  payload         Json
  retryCount      Int               @default(0)
  retryDelay      Int               @default(60000)  // 毫秒
  timeout         Int               @default(300000) // 毫秒
  runAt           DateTime?         // 一次性任务的预定执行时刻；NULL 表示非一次性或已领取
  lastExecutedAt  DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  executions      TaskExecution[]

  @@index([userId, createdAt])
  @@map("scheduled_tasks")
}

model TaskExecution {
  id           String              @id @default(uuid())
  userId       String              @default("")
  taskId       String
  status       TaskExecutionStatus @default(running)
  startedAt    DateTime            @default(now())
  finishedAt   DateTime?
  duration     Int?
  result       Json?
  error        String?
  retryAttempt Int                 @default(0)
  task         ScheduledTask       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, startedAt])
  @@map("task_executions")
}

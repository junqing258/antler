generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RunStatus {
  queued
  running
  awaiting_approval
  succeeded
  failed
  cancelled
}

enum KnowledgeSourceType {
  text
  file
  directory
}
enum KnowledgeSourceStatus {
  pending
  indexing
  ready
  degraded
  failed
  archived
}
enum KnowledgeJobStatus {
  queued
  scanning
  parsing
  chunking
  committing
  succeeded
  failed
  cancelled
  interrupted
}

model Run {
  id             String     @id
  userId         String     @default("")
  projectId      String
  conversationId String
  input          String
  status         RunStatus  @default(queued)
  errorCode      String?
  createdAt      DateTime   @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  events         RunEvent[]
  knowledgeHits  RunKnowledgeHit[]

  @@index([projectId, createdAt])
  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
  @@map("runs")
}

model RunKnowledgeHit {
  id String @id
  runId String
  chunkId String?
  citationKey String
  rank Int
  lexicalScore Float?
  finalScore Float
  titleSnapshot String
  locatorSnapshot Json
  textSnapshot String
  createdAt DateTime @default(now())
  run Run @relation(fields:[runId], references:[id], onDelete:Cascade)
  @@unique([runId, citationKey])
  @@map("run_knowledge_hits")
}

model RunEvent {
  id        Int      @id @default(autoincrement())
  runId     String
  seq       Int
  type      String
  payload   Json
  createdAt DateTime @default(now())
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, seq])
  @@index([runId, seq])
  @@map("run_events")
}

model KnowledgeBase {
  id String @id
  projectId String
  name String
  description String?
  isDefault Boolean @default(false)
  retrievalConfig Json
  indexVersion Int @default(0)
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sources KnowledgeSource[]
  @@index([projectId, updatedAt])
  @@map("knowledge_bases")
}
model KnowledgeSource {
  id String @id
  knowledgeBaseId String
  type KnowledgeSourceType
  uri String?
  displayName String
  config Json
  status KnowledgeSourceStatus @default(pending)
  contentHash String?
  lastIndexedAt DateTime?
  errorCode String?
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  knowledgeBase KnowledgeBase @relation(fields:[knowledgeBaseId], references:[id], onDelete:Cascade)
  documents KnowledgeDocument[]
  jobs KnowledgeIngestionJob[]
  @@index([knowledgeBaseId, updatedAt])
  @@map("knowledge_sources")
}
model KnowledgeDocument {
  id String @id
  sourceId String
  logicalPath String
  title String
  mimeType String
  contentHash String
  metadata Json
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  source KnowledgeSource @relation(fields:[sourceId], references:[id], onDelete:Cascade)
  chunks KnowledgeChunk[]
  @@unique([sourceId, logicalPath])
  @@map("knowledge_documents")
}
model KnowledgeChunk {
  id String @id
  documentId String
  ordinal Int
  text String
  tokenCount Int
  headingPath String?
  locator Json
  contentHash String
  chunkerVersion Int
  indexVersion Int
  createdAt DateTime @default(now())
  document KnowledgeDocument @relation(fields:[documentId], references:[id], onDelete:Cascade)
  @@unique([documentId, ordinal, indexVersion])
  @@map("knowledge_chunks")
}
model KnowledgeIngestionJob {
  id String @id
  sourceId String
  status KnowledgeJobStatus @default(queued)
  phase String @default("queued")
  processed Int @default(0)
  total Int?
  errorCode String?
  cancelRequested Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  source KnowledgeSource @relation(fields:[sourceId], references:[id], onDelete:Cascade)
  events KnowledgeIngestionEvent[]
  @@index([sourceId, createdAt])
  @@map("knowledge_ingestion_jobs")
}
model KnowledgeIngestionEvent {
  id Int @id @default(autoincrement())
  jobId String
  seq Int
  type String
  payload Json
  createdAt DateTime @default(now())
  job KnowledgeIngestionJob @relation(fields:[jobId], references:[id], onDelete:Cascade)
  @@unique([jobId, seq])
  @@map("knowledge_ingestion_events")
}

enum ScheduledTaskType {
  http
  service
  script
}

enum TaskExecutionStatus {
  running
  succeeded
  failed
  timeout
}

model ScheduledTask {
  id              String            @id @default(uuid())
  userId          String            @default("")
  name            String
  description     String?
  type            ScheduledTaskType
  schedule        String            // cron 表达式或 "delay:毫秒"
  enabled         Boolean           @default(true)
  payload         Json
  retryCount      Int               @default(0)
  retryDelay      Int               @default(60000)  // 毫秒
  timeout         Int               @default(300000) // 毫秒
  runAt           DateTime?         // 一次性任务的预定执行时刻；NULL 表示非一次性或已领取
  lastExecutedAt  DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  executions      TaskExecution[]

  @@index([userId, createdAt])
  @@map("scheduled_tasks")
}

model TaskExecution {
  id           String              @id @default(uuid())
  userId       String              @default("")
  taskId       String
  status       TaskExecutionStatus @default(running)
  startedAt    DateTime            @default(now())
  finishedAt   DateTime?
  duration     Int?
  result       Json?
  error        String?
  retryAttempt Int                 @default(0)
  task         ScheduledTask       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, startedAt])
  @@map("task_executions")
}

{
  "name": "@antler/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "pnpm db:generate && node --import tsx scripts/prepare-dev-db.ts",
    "dev": "tsx watch src/index.ts",
    "prebuild": "pnpm db:generate",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "precheck": "pnpm db:generate",
    "check": "tsc --noEmit",
    "pretest": "pnpm db:generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^5.0.3",
    "pglite-prisma-adapter": "^0.7.2",
    "prisma": "7.10.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.1.0",
    "@earendil-works/pi-ai": "^1.1.0",
    "@fastify/compress": "^9.2.1",
    "@fastify/static": "^10.1.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "fastify": "^5.12.1",
    "ignore": "7.0.5",
    "jose": "^6.2.12",
    "node-cron": "^4",
    "typebox": "^1.3.27",
    "yaml": "2.9.0"
  }
}

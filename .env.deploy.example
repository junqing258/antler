# 复制为 .env.deploy，并按部署环境填写。该文件会与 .env 合并，且同名项覆盖 .env。
DEFAULT_TARGET=root@47.100.210.56
DEPLOY_REMOTE_DIR=/opt/antler
ANTLER_WEB_PORT=3210
TZ=Asia/Shanghai

# 可选：也可以仅在浏览器的“供应商配置”中填写模型密钥。
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# ANTLER_MODEL=gpt-4.1-mini
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=
# ANTHROPIC_MODEL=
# TAVILY_API_KEY=
# Docker 镜像预装 Tushare SDK；调用 Pro 接口仍需配置 Token 和相应接口权限。
# TUSHARE_TOKEN=

# backend 内置 antler-rag skill；以下为默认值，可在前端“知识库配置”中覆盖。
# 密钥通过工具进程环境传入，不写入镜像。
# ANTLER_RAG_URL=https://rag.example.com
# ANTLER_RAG_KEY=

# Docker Web 部署直接公开 backend 端口，因此 Compose 不启用本地伴生服务 Token。
# 如需限制公网访问，请使用主机防火墙或外部认证网关。
# ANTLER_MAX_RUN_DURATION_MS=120000
# 本地 .env 可使用内网会话池 192.168.31.120:5432。
# 线上容器通过宿主机 FRP 15432 -> 内网 5432，会话池同时兼容 Prisma 运行时和迁移。
# 不要填写 18000（HTTP 网关），也不要把 16543（事务池）用于 Prisma 迁移。
# 数据库密码中的特殊字符需按 URL 编码；.env.deploy 不应提交到 Git。
# DATABASE_URL=postgresql://postgres.<tenant>:<url-encoded-password>@host.docker.internal:15432/postgres

# 定时任务脚本默认关闭；显式开启前配置 ANTLER_ACCESS_TOKEN 或外部认证网关。
# 子进程仅继承 PATH 和任务显式声明的 env。
# ANTLER_SCHEDULER_ENABLE_SCRIPT=false

# 可选：通过主机共享 Vector 转发 traces；应用不需要 OpenObserve 令牌。
# ANTLER_TRACING_ENABLED=true
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://host.docker.internal:4318/v1/traces
# OTEL_SERVICE_NAME=antler-backend
# OTEL_SERVICE_VERSION=deployment-image-tag
# ANTLER_TRACE_SAMPLE_RATIO=1

# 复制为 .env.deploy，并按部署环境填写。该文件会与 .env 合并，且同名项覆盖 .env。
DEFAULT_TARGET=root@47.100.210.56
DEPLOY_REMOTE_DIR=/opt/antler
ANTLER_WEB_PORT=3210
TZ=Asia/Shanghai

# 可选：也可以仅在浏览器的“供应商配置”中填写模型密钥。
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# ANTLER_MODEL=gpt-4.1-mini
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=
# ANTHROPIC_MODEL=
# TAVILY_API_KEY=

# Docker Web 部署直接公开 backend 端口，因此 Compose 不启用本地伴生服务 Token。
# 如需限制公网访问，请使用主机防火墙或外部认证网关。
# ANTLER_MAX_RUN_DURATION_MS=120000

{
  "expo": {
    "name": "Antler",
    "slug": "antler-p0-probe",
    "scheme": "antler",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "ios": {
      "bundleIdentifier": "com.antler.p0probe",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": false
        }
      }
    },
    "android": {
      "package": "com.antler.p0probe",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}

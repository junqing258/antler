generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RunStatus {
  queued
  running
  awaiting_approval
  succeeded
  failed
  cancelled
}

model Run {
  id                 String     @id
  userId             String     @default("")
  projectId          String
  conversationId     String
  agentId            String?
  agentFingerprint   String?
  skillPolicy        Json?
  catalogFingerprint String?
  clientRequestId    String?
  requestHash        String?
  executionConfig    Json?
  input              String
  status             RunStatus  @default(queued)
  errorCode          String?
  createdAt          DateTime   @default(now())
  startedAt          DateTime?
  finishedAt         DateTime?
  events             RunEvent[]

  @@unique([userId, clientRequestId])
  @@index([projectId, createdAt])
  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
  @@map("runs")
}

model RunEvent {
  id        Int      @id @default(autoincrement())
  runId     String
  seq       Int
  type      String
  payload   Json
  createdAt DateTime @default(now())
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, seq])
  @@index([runId, seq])
  @@map("run_events")
}

enum ScheduledTaskType {
  http
  service
  script
}

enum TaskExecutionStatus {
  running
  succeeded
  failed
  timeout
}

model ScheduledTask {
  id             String            @id @default(uuid())
  userId         String            @default("")
  name           String
  description    String?
  type           ScheduledTaskType
  schedule       String // cron 表达式或 "delay:毫秒"
  enabled        Boolean           @default(true)
  payload        Json
  retryCount     Int               @default(0)
  retryDelay     Int               @default(60000) // 毫秒
  timeout        Int               @default(300000) // 毫秒
  runAt          DateTime? // 一次性任务的预定执行时刻；NULL 表示非一次性或已领取
  lastExecutedAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  executions     TaskExecution[]

  @@index([userId, createdAt])
  @@map("scheduled_tasks")
}

model TaskExecution {
  id           String              @id @default(uuid())
  userId       String              @default("")
  taskId       String
  status       TaskExecutionStatus @default(running)
  startedAt    DateTime            @default(now())
  finishedAt   DateTime?
  duration     Int?
  result       Json?
  error        String?
  retryAttempt Int                 @default(0)
  task         ScheduledTask       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, startedAt])
  @@map("task_executions")
}

enum AgentStatus {
  draft
  published
}

enum SkillState {
  ready
  broken
  tampered
}

model Agent {
  id           String       @id @default(uuid())
  ownerId      String       @default("")
  name         String
  description  String
  systemPrompt String
  icon         String?
  status       AgentStatus  @default(draft)
  publishedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  skills       AgentSkill[]

  @@index([status, publishedAt])
  @@index([ownerId, updatedAt])
  @@map("agents")
}

model AgentSkill {
  agentId  String
  skillId  String
  agent    Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skill    Skill  @relation(fields: [skillId], references: [id], onDelete: Restrict)
  position Int    @default(0)

  @@id([agentId, skillId])
  @@index([skillId])
  @@map("agent_skills")
}

model Skill {
  id                     String       @id @default(uuid())
  ownerId                String       @default("")
  name                   String       @unique
  description            String
  // Legacy field retained for schema compatibility; cache paths are derived from id.
  directory              String
  state                  SkillState   @default(ready)
  disableModelInvocation Boolean      @default(false)
  fileCount              Int
  sizeBytes              Int
  fingerprint            String
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  agents                 AgentSkill[]
  files                  SkillFile[]

  @@index([ownerId, updatedAt])
  @@map("skills")
}

model SkillFile {
  skillId String
  path    String
  content Bytes
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([skillId, path])
  @@map("skill_files")
}

model Conversation {
  id String @id
  userId String
  agentId String?
  executionConfig Json
  title String
  titleSource String @default("fallback")
  checkpoint Json?
  messageStorage String @default("database")
  contextState String @default("not_restored")
  revision Int @default(1)
  // 诊断 hint：cos-v1 会话已确认提交到 COS 的正文提交序号近似值，
  // 不参与条件更新协议，也绝不保存消息正文或事件 payload。
  storageGeneration Int @default(0)
  activeRunId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastMessageAt DateTime @default(now())
  deletedAt DateTime?
  messages ConversationMessage[]

  @@index([userId, lastMessageAt, id])
  @@index([userId, agentId, lastMessageAt, id])
  @@map("conversations")
}

/// 删除恢复（docs/21 §4.5）：与墓碑同一事务创建，各阶段可续跑，
/// 崩溃后不依赖内存队列；stage: pending → deleting → manifest → done。
model ConversationDeletionTask {
  id String @id @default(uuid())
  conversationId String
  userId String
  marker String
  /// 可恢复的对象键清单；由工作器先读取 manifest 后持久记录。
  keys Json?
  stage String @default("pending")
  attempts Int @default(0)
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage, createdAt])
  @@map("conversation_deletion_tasks")
}

/// 垃圾回收候选（docs/21 §4.4）：对象变为不可达时记录键与首次发现时间，
/// 经过宽限期且确认仍不被 manifest/删除任务/暂存引用后删除。
model StorageGarbageCandidate {
  key String @id
  conversationId String
  firstSeenAt DateTime @default(now())

  @@index([firstSeenAt])
  @@map("storage_garbage_candidates")
}

model ConversationMessage {
  id String @id
  conversationId String
  userId String
  seq Int
  runId String
  role String
  content Json
  status String
  appliedEventId Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@unique([conversationId, seq])
  @@unique([runId, role])
  @@index([userId, conversationId, seq])
  @@map("conversation_messages")
}

model ConversationSyncState {
  userId String @id
  lastChangeId Int @default(0)
  @@map("conversation_sync_states")
}

model ConversationChange {
  userId String
  changeId Int
  conversationId String
  revision Int
  type String
  createdAt DateTime @default(now())
  @@id([userId, changeId])
  @@index([createdAt])
  @@map("conversation_changes")
}
